#!/usr/bin/env bash
# omarchy-ledge — command line front end for the Ledge plugin.
#
# The plugin runs inside the long lived omarchy-shell process; this script only
# talks to it over the shell's own IPC. The ledge registers one IPC target,
# named after the plugin, and it exists as long as the ledge's widget is on
# the bar.

set -euo pipefail

PLUGIN_ID="bylund.ledge"
IPC_TARGET="bylund.ledge"
VERSION="0.1.0"

die() {
  printf 'omarchy-ledge: %s\n' "$1" >&2
  exit 1
}

usage() {
  cat <<'EOF'
Usage: omarchy-ledge <command> [arguments]

Commands:
  add [--no-show] <file>...  Put files on the ledge (opens the ledge)
  list                       Print the files currently on the ledge
  count                      Print how many files are on the ledge
  clear                      Remove everything from the ledge
  show | toggle | hide       Open or close the ledge under its bar icon
  help | version

Examples:
  omarchy-ledge add ~/Pictures/screenshot.png
  omarchy-ledge add --no-show ./report.pdf ../notes.md
  omarchy-ledge list | wl-copy
EOF
}

require_shell() {
  command -v omarchy-shell >/dev/null 2>&1 ||
    die "omarchy-shell not found — is this an Omarchy session?"
}

# Every command goes through the plugin's own IPC target. The target only
# exists while the ledge's widget is on the bar, so a failure almost always
# means the widget was removed from the bar (or the shell is not running).
ledge() {
  omarchy-shell "$IPC_TARGET" "$@" ||
    die "the ledge did not answer — is its widget on the bar? (omarchy bar put $PLUGIN_ID)"
}

# Minimal JSON string escaping: enough for file paths, which may contain
# quotes, backslashes, tabs and (rarely) newlines.
json_escape() {
  local s=$1
  s=${s//\\/\\\\}
  s=${s//\"/\\\"}
  s=${s//$'\t'/\\t}
  s=${s//$'\r'/\\r}
  s=${s//$'\n'/\\n}
  printf '"%s"' "$s"
}

# The shell's IPC layer reads an argument that starts with "[" as an argument
# list and splits it across the method's parameters, so the paths travel inside
# an object instead of as a bare array.
json_payload() {
  local out="" item
  for item in "$@"; do
    if [ -n "$out" ]; then
      out+=","
    fi
    out+=$(json_escape "$item")
  done
  printf '{"paths":[%s]}' "$out"
}

cmd_add() {
  local show=1
  local files=()

  while [ $# -gt 0 ]; do
    case $1 in
      --no-show | -n)
        show=0
        shift
        ;;
      --)
        shift
        break
        ;;
      -*)
        die "unknown option: $1"
        ;;
      *)
        break
        ;;
    esac
  done

  [ $# -gt 0 ] || die "add needs at least one file"

  local file abs
  for file in "$@"; do
    [ -e "$file" ] || die "no such file: $file"
    abs=$(realpath -- "$file")
    files+=("$abs")
  done

  local payload
  payload=$(json_payload "${files[@]}")

  # Quiet on success, the way a well behaved command is; the ledge itself says
  # what happened, with a toast and the count on its bar icon.
  if [ "$show" -eq 1 ]; then
    ledge add "$payload" >/dev/null
  else
    ledge addQuiet "$payload" >/dev/null
  fi
}

main() {
  local subcommand=${1:-help}
  if [ $# -gt 0 ]; then
    shift
  fi

  case $subcommand in
    add)
      require_shell
      cmd_add "$@"
      ;;
    list)
      require_shell
      ledge list
      ;;
    count)
      require_shell
      ledge count
      ;;
    clear)
      require_shell
      ledge clear >/dev/null
      ;;
    show | toggle | hide)
      require_shell
      ledge "$subcommand"
      ;;
    help | --help | -h)
      usage
      ;;
    version | --version | -v)
      printf 'omarchy-ledge %s\n' "$VERSION"
      ;;
    *)
      usage >&2
      die "unknown command: $subcommand"
      ;;
  esac
}

main "$@"
